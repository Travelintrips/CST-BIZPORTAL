# Replit — .replit is local/platform-managed and must not be overwritten by git pull.
.cache/
.local/
summary.json
.replit

# Agent outputs & chat uploads — bukan bagian dari source code
.agents/outputs/
attached_assets/
screenshots/
artifacts/customer-portal/public/__t.html
artifacts/customer-portal/public/__dev_auth.html

# Auto-generated by Replit canvas/mockup system — berubah otomatis, jangan di-commit
artifacts/mockup-sandbox/src/.generated/

# Replit runtime & temp files — auto-generated, bukan source code
nohup.out
install.pid
skills-lock.json
.agents/agent_assets_metadata.toml

# Temp .replit config backups (random 8-char names dibuat Replit saat switch config)
sed??????
# Database backups & dumps — jangan pernah di-commit
backups/

# UAT artifacts (test tokens, API response snapshots)
.uat/

