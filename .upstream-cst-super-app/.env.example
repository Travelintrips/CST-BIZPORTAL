# ============================================================
# CST Super App — Required Environment Variables
# Copy this file to .env and fill in the values.
# In production / Replit, set these as Secrets, not a .env file.
# ============================================================

# ── Google Cloud Secret Manager (loads remaining secrets at startup) ──────────
# GCP project that owns the secret
GCP_PROJECT_ID=

# Name of the secret in Secret Manager (without /versions/latest)
GCP_SECRET_ID=

# Service-account JSON with roles/secretmanager.secretAccessor
GCP_SECRET_MANAGER_BOOTSTRAP_JSON=

# ── Supabase — Database (required for API to start) ───────────────────────────
# Production pooler URL  (postgres://postgres.<ref>:<pass>@host:6543/postgres)
SUPABASE_DATABASE_URL=

# Development pooler URL (leave blank to use SUPABASE_DATABASE_URL in dev)
SUPABASE_DATABASE_URL_DEV=

# Supabase project URLs
SUPABASE_URL=
SUPABASE_URL_DEV=

# Service-role keys (server-side only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY_DEV=

# Anonymous / public keys (safe for browser)
SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY_DEV=

# Supabase production project reference (used by envGuard to detect dev→prod misuse)
# Defaults to the hardcoded ref in envGuard.ts if not set.
SUPABASE_PROD_PROJECT_REF=

# ── Session ───────────────────────────────────────────────────────────────────
# Random 32+ char string for signing Express sessions
SESSION_SECRET=

# ── Payments ──────────────────────────────────────────────────────────────────
# Paylabs RSA private key (PEM format, base64-encoded or raw)
PAYLABS_PRIVATE_KEY=
PAYLABS_MERCHANT_ID=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Fonnte (https://fonnte.com)
FONNTE_TOKEN=

# Wati (https://wati.io)
WATI_API_TOKEN=
WATI_API_URL=

# ── AI / OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Google Sheets / Drive ─────────────────────────────────────────────────────
# Service-account JSON with Editor access to relevant sheets
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Email (optional — SMTP) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Ports (development defaults — usually no need to change) ──────────────────
PORT=5000
API_PORT=18444
BIZPORTAL_PORT=18442
CUSTOMER_PORT=23434
LOGISTIC_ORDER_PORT=19368
