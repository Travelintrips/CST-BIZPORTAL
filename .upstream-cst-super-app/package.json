{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck:libs && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build --force",
    "build:libs": "pnpm run typecheck:libs",
    "dev:api": "pnpm --filter @workspace/api-server run dev:secure",
    "dev:bizportal": "pnpm --filter @workspace/bizportal run dev",
    "dev:customer-portal": "pnpm --filter @workspace/customer-portal run dev",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:verify:dev": "node scripts/verify-db-target.mjs --env dev",
    "db:verify:prod": "node scripts/verify-db-target.mjs --env prod",
    "db:preflight:canonical": "node scripts/preflight-canonical-settlement.mjs",
    "db:preflight:canonical:prod": "node scripts/preflight-canonical-settlement.mjs --env production",
    "db:migrate:cf-sc-12b:prod": "pnpm --filter @workspace/api-server build && node artifacts/api-server/build-migrations.mjs && APP_ENV=production node artifacts/api-server/load-secrets.mjs node scripts/cf-sc-12b-targeted-prod-migration.mjs",
    "audit:cf-sc-13b:parity": "bash scripts/cf-sc-13b-parity.sh",
    "db:restore:canonical:dev": "node artifacts/api-server/build-migrations.mjs && cd artifacts/api-server && APP_ENV=development node load-secrets.mjs node dist/run-canonical-contract-migration.mjs",
    "db:migrate:test": "RUNTIME_ENV=test node scripts/apply-migrations.mjs",
    "audit:tax-coa:dev": "APP_ENV=development bash scripts/verify-tax-coa-activation.sh",
    "audit:tax-coa:prod": "APP_ENV=production bash scripts/verify-tax-coa-activation.sh",
    "audit:customer-runtime-dev": "node scripts/runtime-safe-dev-test.mjs",
    "audit:customer-static": "bash scripts/audit-customer-static.sh",
    "audit:customer-runtime": "bash scripts/audit-customer-runtime.sh",
    "audit:customer-production": "bash scripts/audit-customer-production.sh",
    "audit:customer-integration": "bash scripts/audit-customer-integration.sh",
    "audit:secrets": "node scripts/validate-secret-rotation.mjs",
    "audit:secret-availability": "node scripts/validate-secret-rotation.mjs",
    "audit:secret-rotation": "node scripts/check-secret-rotation-status.mjs",
    "audit:customer-http-e2e": "bash scripts/audit-customer-http-e2e.sh",
    "verify:gateway": "node scripts/verify-gateway-source.mjs",
    "verify:portals": "node scripts/verify-portal-boundaries.mjs",
    "verify:frontend-boundaries": "pnpm run verify:portals && pnpm run verify:gateway",
    "assets:customer:manifest": "node artifacts/api-server/scripts/customer-portal-assets.mjs manifest --write",
    "assets:customer:verify": "node artifacts/api-server/scripts/customer-portal-assets.mjs verify",
    "assets:customer:promote": "node artifacts/api-server/scripts/customer-portal-assets.mjs promote --dry-run",
    "test:customer-assets": "node --test artifacts/api-server/scripts/customer-portal-assets.test.mjs",
    "audit:secret-rotation-status": "node scripts/secret-rotation-status.mjs",
    "deployment:preflight": "APP_ENV=production REPLIT_DEPLOYMENT=1 node artifacts/api-server/load-secrets.mjs node scripts/preflight-deployment.mjs",
    "deployment:dry-run": "node scripts/preflight-deployment.mjs --dry-run",
    "validate:production-go": "node scripts/validate-production-go.mjs",
    "smoke:prod": "bash scripts/smoke-test-prod.sh \"${PROD_URL:-}\""
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "core-js",
      "@whiskeysockets/baileys",
      "protobufjs"
    ],
    "overrides": {
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "lodash@<=4.17.23": "4.18.1",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=6.0.0 <6.2.4": "6.2.4",
      "nodemailer@<=8.0.8": "8.0.9",
      "markdown-it@<=14.1.1": "14.2.0",
      "js-yaml@<=4.1.1": "4.2.0",
      "dompurify@<3.4.9": "3.4.9",
      "vite@>=7.0.0 <=7.3.4": "7.3.5",
      "@babel/core@<=7.29.0": "7.29.6",
      "tar@<=7.5.19": "7.5.20",
      "form-data@<2.5.6": "2.5.6",
      "tmp@<0.2.7": "0.2.7",
      "esbuild@>=0.0.0 <0.28.1": "0.28.1",
      "postcss@<8.5.10": "8.5.10",
      "uuid@<14.0.0": "14.0.0",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "ip-address@<10.2.0": "10.2.0",
      "fast-xml-builder@<=1.1.6": "1.1.9",
      "fast-uri@<=3.1.0": "3.1.2",
      "qs@<6.15.2": "6.15.2",
      "shell-quote@<=1.8.3": "1.8.4"
    },
    "packageExtensions": {
      "react-native-worklets@*": {
        "exports": {
          ".": "./lib/module/index",
          "./plugin": "./plugin/index.js"
        }
      }
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "@types/pg": "^8.18.0",
    "@types/web-push": "^3.6.4",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/react": "^5.2.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.20.0",
    "react-image-crop": "^11.0.10",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  }
}
