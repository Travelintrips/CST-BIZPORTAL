modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]

[userenv.development]
APP_ENV = "development"
DEV_LOGIN_EMAILS = "admcst001@gmail.com"
DEV_LOGIN_ROLE = "admin"
BIZPORTAL_API_ORIGIN_DEV = "https://bizportal.cstlogistic.co.id"
# Path-based Replit routing: browser requests stay same-origin under /api.
VITE_API_SERVER_URL_DEV = "/api"

[userenv.production]
APP_ENV = "production"
MKT_DUAL_WRITE_RETRY_ENABLED = "false"
BIZPORTAL_API_ORIGIN_PROD = "https://cstlogistic.co.id"

[nix]
channel = "stable-25_05"
