modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]

[userenv.development]
APP_ENV = "development"
DEV_LOGIN_EMAILS = "admcst001@gmail.com"
DEV_LOGIN_ROLE = "admin"
BIZPORTAL_API_ORIGIN_DEV = "https://bizportal.cstlogistic.co.id"
VITE_API_SERVER_URL_DEV = "https://1c591a26-1875-444f-9a51-2733d23fd756-00-3bxi1sstpdetn.pike.replit.dev/bizportal/"
DEV_LOGIN_EMAILS = "admcst001@gmail.com"
DEV_LOGIN_ROLE = "admin"

[userenv.production]
APP_ENV = "production"
MKT_DUAL_WRITE_RETRY_ENABLED = "false"

[nix]
channel = "stable-25_05"
