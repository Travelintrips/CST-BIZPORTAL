modules = ["nodejs-20", "python-3.12", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["node", "--max-http-header-size=65536", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
DEV_LOGIN_EMAILS = "admcst001@gmail.com"
DEV_LOGIN_ROLE = "admin"
BIZPORTAL_API_ORIGIN_DEV = "http://127.0.0.1:18444"
BIZPORTAL_BACKEND_API_ORIGIN = "http://127.0.0.1:18444"
SUPABASE_URL = "https://nzdweipzckfszczzqtuw.supabase.co"

[userenv.production]
BIZPORTAL_API_ORIGIN_PROD = "https://bizportal.cstlogistic.co.id"

[nix]
channel = "stable-25_05"
