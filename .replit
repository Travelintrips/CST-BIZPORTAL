modules = ["nodejs-20", "python-3.12", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CST BizPortal upstream API"

[[workflows.workflow]]
name = "CST BizPortal upstream API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd .upstream-cst-super-app/artifacts/api-server && APP_ENV=development NODE_ENV=development PORT=18444 pnpm run dev"
waitForPort = 18444

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
DEV_LOGIN_EMAILS = "admcst001@gmail.com"
DEV_LOGIN_ROLE = "admin"
BIZPORTAL_API_ORIGIN_DEV = "http://127.0.0.1:18444"
BIZPORTAL_BACKEND_API_ORIGIN = "http://127.0.0.1:18444"
SUPABASE_URL = "https://nzdweipzckfszczzqtuw.supabase.co"

[userenv.production]
BIZPORTAL_API_ORIGIN_PROD = "https://bizportal.cstlogistic.co.id"
SUPABASE_DATABASE_URL = "postgresql://postgres:9WzfJzyNQxOn5Owu@db.nzdweipzckfszczzqtuw.supabase.co:6543/postgres"

